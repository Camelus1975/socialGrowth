# ==============================================
# App Founder Growth Suite - Environment Variables
# ==============================================

# Supabase Connection (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Encryption (REQUIRED)
ENCRYPTION_SECRET=generate_a_strong_random_secret_here
ENCRYPTION_SALT=generate_a_strong_random_salt_here

# Server Settings
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-production-domain.up.railway.app

# Redis Connection (Required for background workers)
REDIS_URL=rediss://default:your_redis_password@your-redis-host:6379

# OpenAI (Required for AI features)
OPENAI_API_KEY=sk-your-openai-key

# Replicate (Required for FLUX image generation)
REPLICATE_API_TOKEN=r8_your_replicate_token

# Meta / Facebook / Instagram OAuth
FACEBOOK_CLIENT_ID=your_meta_app_id
FACEBOOK_CLIENT_SECRET=your_meta_app_secret
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_REDIRECT_URI=https://your-domain.com/api/social/oauth/facebook/callback
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# X (Twitter) OAuth 2.0 PKCE
X_CLIENT_ID=your_x_twitter_client_id
X_CLIENT_SECRET=your_x_twitter_client_secret

# TikTok Business API v2
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Google / YouTube Data API v3
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Pinterest OAuth v5
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret

# Threads API
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret

# Application Base URL
APP_BASE_URL=https://your-domain.com
